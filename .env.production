# Site Configuration
NEXT_PUBLIC_SITE_URL=https://joonangler.github.io
NEXT_PUBLIC_SITE_NAME=Joonangler.log
NEXT_PUBLIC_SITE_DESCRIPTION=Joonangler blog

# Author Information
NEXT_PUBLIC_AUTHOR_NAME=Joonangler
NEXT_PUBLIC_AUTHOR_IMAGE='/images/profile.jpg'

# Social Links (Optional)
#NEXT_PUBLIC_TWITTER_HANDLE=@handle
NEXT_PUBLIC_GITHUB_URL=https://github.com/joonangler

# Google Analytics 4 (Optional - Can be injected via GitHub Secrets)
# Get your GA ID from https://analytics.google.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Giscus (Comment System - Optional - Can be injected via GitHub Secrets)
# Configure at https://giscus.app
# NEXT_PUBLIC_GISCUS_REPO=owner/repo
# NEXT_PUBLIC_GISCUS_REPO_ID=R_xxxxx
# NEXT_PUBLIC_GISCUS_CATEGORY=General
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxx
